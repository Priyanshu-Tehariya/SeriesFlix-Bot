# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF...
ADMIN_IDS=111111111,222222222
INDEX_CHANNEL_ID=-1001234567890
REQUEST_CHANNEL_ID=-1009876543210   # Channel for /request moderation cards
LOG_CHANNEL_ID=-1009876543211       # Channel for indexing, ban, and deletion logs

# --- Postgres ---
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tv_series_bot
DATABASE_URL=postgresql+asyncpg://bot_user:change_me@postgres:5432/tv_series_bot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- App ---
TMDB_API_KEY=your_tmdb_api_key_here
SQL_ECHO=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Force Subscription Channels Configuration
# ------------------------------------------------------------------
# Comma-separated list of channel usernames or numerical IDs (e.g., @MyChannel,-1001234567890)
FORCE_SUB_CHANNELS=

# Optional comma-separated list of invite links for private channels (e.g., [https://t.me/+InviteLink](https://t.me/+InviteLink))
FORCE_SUB_LINKS=
